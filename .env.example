# ==============================================================
# BIẾN MÔI TRƯỜNG MẪU (ENV CONFIGURATION TEMPLATE)
# Dành cho khi triển khai kết nối Backend Node.js / PostgreSQL / Webhook
# ==============================================================

# Cấu hình Server
NODE_ENV=development
PORT=8080
APP_URL=http://localhost:8080

# Cấu hình Ngân hàng VietQR (Chuẩn Napas247)
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0388998899
VIETQR_ACCOUNT_NAME="TIEM NUOC XANH VI"
VIETQR_TEMPLATE=compact2

# Cấu hình Webhook cổng đối soát tự động (Ví dụ: SePay / Casso / VietQR Pro)
# Không chia sẻ Secret Key lên kho mã nguồn công khai
PAYMENT_GATEWAY_WEBHOOK_URL=/api/webhooks/payment
PAYMENT_GATEWAY_API_KEY=your_api_key_here
PAYMENT_GATEWAY_SECRET_KEY=your_webhook_secret_here

# Cơ sở dữ liệu (Khi nâng cấp từ SQLite lên PostgreSQL)
DATABASE_TYPE=sqlite
DATABASE_URL=file:./data/xanhviquan.db
# DATABASE_URL=postgresql://user:password@localhost:5432/xanhviquan

# Xác thực Quản trị (Admin JWT)
JWT_SECRET=super_secret_jwt_key_change_in_production
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
